#!/bin/bash
# cc-key-audit - Comprehensive API key audit utility for Confluent Cloud

# Get script directory and source shared libraries
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="$(dirname "$SCRIPT_DIR")/lib"

source "$LIB_DIR/common.sh"
source "$LIB_DIR/config.sh"
source "$LIB_DIR/validation.sh"
source "$LIB_DIR/output.sh"

# Script metadata
SCRIPT_NAME="cc-key-audit"
SCRIPT_VERSION="1.0.0"
SCRIPT_DESCRIPTION="Comprehensive API key audit utility for Confluent Cloud"

# Default values
DEFAULT_OUTPUT_FORMAT="table"
DEFAULT_AGE_WARNING_DAYS=90
DEFAULT_AGE_CRITICAL_DAYS=180

# Usage function
usage() {
    cat << EOF
${BLUE}${AUDIT} $SCRIPT_NAME v$SCRIPT_VERSION${RESET}
$SCRIPT_DESCRIPTION

${YELLOW}Usage:${RESET}
  $SCRIPT_NAME [OPTIONS]

${YELLOW}Options:${RESET}
  -o, --output FORMAT         Output format (table, json, csv, yaml, html)
  -f, --filter FILTER         Filter keys (all, active, inactive, old, unused)
  -a, --age-warning DAYS      Age warning threshold in days (default: $DEFAULT_AGE_WARNING_DAYS)
  -c, --age-critical DAYS     Age critical threshold in days (default: $DEFAULT_AGE_CRITICAL_DAYS)
  -r, --report-file FILE      Save report to file
  -e, --env-file FILE         Environment file path (default: .env)
  -q, --quiet                 Suppress non-essential output
  -v, --verbose               Increase output verbosity
  -s, --summary               Show summary only
  -d, --detailed              Show detailed analysis
  -u, --unused                Identify unused/stale keys
  -p, --permissions           Analyze permission scopes
  -h, --help                 Show this help message

${YELLOW}Examples:${RESET}
  $SCRIPT_NAME                           # Basic audit with table output
  $SCRIPT_NAME -o json -r audit.json     # JSON report saved to file
  $SCRIPT_NAME -f old -a 60              # Show keys older than 60 days
  $SCRIPT_NAME -u -p                     # Unused keys with permission analysis
  $SCRIPT_NAME -o html -r report.html    # HTML report

${YELLOW}Filter Options:${RESET}
  all         All API keys (default)
  active      Currently active keys
  inactive    Inactive or disabled keys
  old         Keys older than age threshold
  unused      Keys not used recently

EOF
}

# Parse command line arguments
parse_args() {
    while [[ $# -gt 0 ]]; do
        case $1 in
            -o|--output)
                OUTPUT_FORMAT="$2"
                shift 2
                ;;
            -f|--filter)
                FILTER_TYPE="$2"
                shift 2
                ;;
            -a|--age-warning)
                AGE_WARNING_DAYS="$2"
                shift 2
                ;;
            -c|--age-critical)
                AGE_CRITICAL_DAYS="$2"
                shift 2
                ;;
            -r|--report-file)
                REPORT_FILE="$2"
                shift 2
                ;;
            -e|--env-file)
                CC_ENV_FILE="$2"
                shift 2
                ;;
            -q|--quiet)
                CC_QUIET="true"
                shift
                ;;
            -v|--verbose)
                CC_VERBOSE="true"
                shift
                ;;
            -s|--summary)
                SUMMARY_ONLY="true"
                shift
                ;;
            -d|--detailed)
                DETAILED_ANALYSIS="true"
                shift
                ;;
            -u|--unused)
                ANALYZE_UNUSED="true"
                shift
                ;;
            -p|--permissions)
                ANALYZE_PERMISSIONS="true"
                shift
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            *)
                error "Unknown option: $1"
                usage
                exit 1
                ;;
        esac
    done
}

# Get all API keys with details
get_api_keys() {
    progress "Retrieving API key information"
    
    local output
    if output=$(confluent api-key list --output json 2>&1); then
        echo "$output"
    else
        error "Failed to retrieve API keys: $output"
        return 1
    fi
}

# Get detailed information for a specific key
get_key_details() {
    local api_key="$1"
    
    local output
    if output=$(confluent api-key describe "$api_key" --output json 2>&1); then
        echo "$output"
    else
        debug "Failed to get details for key $api_key: $output"
        return 1
    fi
}

# Calculate key age in days (simplified for macOS compatibility)
calculate_key_age() {
    local created_date="$1"
    
    if [[ -z "$created_date" || "$created_date" == "null" ]]; then
        echo "0"
        return
    fi
    
    # Extract date part from ISO format (YYYY-MM-DD)
    local date_part="${created_date%%T*}"
    
    if [[ "$date_part" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
        # Simple age calculation - just count days since creation
        local year="${date_part:0:4}"
        local month="${date_part:5:2}"
        local day="${date_part:8:2}"
        
        local current_date=$(date +%Y-%m-%d)
        local current_year="${current_date:0:4}"
        local current_month="${current_date:5:2}"
        local current_day="${current_date:8:2}"
        
        # Simple approximation: assume 30 days per month
        local created_days=$(( (year - 2020) * 365 + (month - 1) * 30 + day ))
        local current_days=$(( (current_year - 2020) * 365 + (current_month - 1) * 30 + current_day ))
        local age_days=$((current_days - created_days))
        
        if [[ $age_days -lt 0 ]]; then
            echo "0"
        else
            echo "$age_days"
        fi
    else
        echo "0"
    fi
}

# Determine key status based on age and usage
determine_key_status() {
    local age_days="$1"
    local last_used="$2"
    
    if [[ "$age_days" == "unknown" ]]; then
        echo "unknown"
        return
    fi
    
    if [[ $age_days -ge $AGE_CRITICAL_DAYS ]]; then
        echo "critical"
    elif [[ $age_days -ge $AGE_WARNING_DAYS ]]; then
        echo "warning"
    elif [[ -z "$last_used" || "$last_used" == "null" || "$last_used" == "never" ]]; then
        echo "unused"
    else
        echo "active"
    fi
}

# Analyze key permissions (placeholder - would need actual permission data)
analyze_key_permissions() {
    local api_key="$1"
    local resource_id="$2"
    
    # This is a placeholder - actual implementation would depend on
    # available Confluent Cloud APIs for permission analysis
    if [[ "$resource_id" =~ ^lkc- ]]; then
        echo "kafka:read,write"
    elif [[ "$resource_id" =~ ^psrc- ]]; then
        echo "schema-registry:read,write"
    elif [[ "$resource_id" =~ ^lksqlc- ]]; then
        echo "ksql:read,write"
    elif [[ "$resource_id" =~ ^lcc- ]]; then
        echo "connect:read,write"
    else
        echo "unknown"
    fi
}

# Filter keys based on criteria
filter_keys() {
    local keys_data="$1"
    local filter_type="$2"
    
    case "$filter_type" in
        all)
            echo "$keys_data"
            ;;
        active)
            echo "$keys_data" | jq '[.[] | select(.status == "active")]'
            ;;
        inactive)
            echo "$keys_data" | jq '[.[] | select(.status == "inactive" or .status == "unused")]'
            ;;
        old)
            echo "$keys_data" | jq --arg days "$AGE_WARNING_DAYS" '[.[] | select(.age_days != "unknown" and (.age_days | tonumber) >= ($days | tonumber))]'
            ;;
        unused)
            echo "$keys_data" | jq '[.[] | select(.status == "unused")]'
            ;;
        *)
            echo "$keys_data"
            ;;
    esac
}

# Process and enrich API key data (simplified)
process_api_keys() {
    local raw_keys="$1"
    
    progress "Processing API key data"
    
    if ! command_exists jq; then
        warning "jq not available - limited processing capabilities"
        echo "$raw_keys"
        return
    fi
    
    # Add status and age fields directly to the raw data
    echo "$raw_keys" | jq '[.[] | {key: .key, description: .description, resource_id: .resource, resource_type: .resource_type, created_date: .created, age_days: "0", status: "active", last_used: "unknown", permissions: ""}]'
}

# Generate audit summary
generate_summary() {
    local keys_data="$1"
    
    if ! command_exists jq; then
        warning "jq not available - cannot generate summary"
        return
    fi
    
    # Check if keys_data is valid JSON and not empty
    if [[ -z "$keys_data" ]] || ! echo "$keys_data" | jq . >/dev/null 2>&1; then
        warning "No valid key data available for summary"
        return
    fi
    
    local total_keys=$(echo "$keys_data" | jq 'length' 2>/dev/null || echo "0")
    local active_keys=$(echo "$keys_data" | jq '[.[] | select(.status == "active")] | length' 2>/dev/null || echo "0")
    local warning_keys=$(echo "$keys_data" | jq '[.[] | select(.status == "warning")] | length' 2>/dev/null || echo "0")
    local critical_keys=$(echo "$keys_data" | jq '[.[] | select(.status == "critical")] | length' 2>/dev/null || echo "0")
    local unused_keys=$(echo "$keys_data" | jq '[.[] | select(.status == "unused")] | length' 2>/dev/null || echo "0")
    local unknown_keys=$(echo "$keys_data" | jq '[.[] | select(.status == "unknown")] | length' 2>/dev/null || echo "0")
    
    header "Audit Summary" "$AUDIT"
    
    display_key_value \
        "Total Keys=$total_keys" \
        "Active Keys=$active_keys" \
        "Warning Keys=$warning_keys" \
        "Critical Keys=$critical_keys" \
        "Unused Keys=$unused_keys" \
        "Unknown Status=$unknown_keys"
    
    echo
    
    # Recommendations
    if [[ $critical_keys -gt 0 ]]; then
        warning "$critical_keys keys are older than $AGE_CRITICAL_DAYS days - consider rotation"
    fi
    
    if [[ $unused_keys -gt 0 ]]; then
        warning "$unused_keys keys appear unused - consider cleanup"
    fi
    
    if [[ $warning_keys -gt 0 ]]; then
        info "$warning_keys keys are approaching age threshold - monitor for rotation"
    fi
}

# Output keys in table format
output_table_format() {
    local keys_data="$1"
    
    if ! command_exists jq; then
        error "jq required for table output"
        return 1
    fi
    
    local headers="Key,Description,Resource,Age (days),Status,Last Used"
    local rows=()
    
    while IFS= read -r key_json; do
        local key=$(echo "$key_json" | jq -r '.key')
        local description=$(echo "$key_json" | jq -r '.description')
        local resource_id=$(echo "$key_json" | jq -r '.resource_id')
        local age_days=$(echo "$key_json" | jq -r '.age_days')
        local status=$(echo "$key_json" | jq -r '.status')
        local last_used=$(echo "$key_json" | jq -r '.last_used // "Never"')
        
        # Truncate long descriptions
        if [[ ${#description} -gt 30 ]]; then
            description="${description:0:27}..."
        fi
        
        # Format status with colors
        local formatted_status
        formatted_status=$(format_status "$status")
        
        local row="$key,$description,$resource_id,$age_days,$formatted_status,$last_used"
        rows+=("$row")
        
    done < <(echo "$keys_data" | jq -c '.[]')
    
    output_status_table "$headers" "${rows[@]}"
}

# Output keys in HTML format
output_html_format() {
    local keys_data="$1"
    local output_file="$2"
    
    if ! command_exists jq; then
        error "jq required for HTML output"
        return 1
    fi
    
    cat > "$output_file" << 'EOF'
<!DOCTYPE html>
<html>
<head>
    <title>Confluent Cloud API Key Audit Report</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; }
        h1 { color: #2c3e50; }
        table { border-collapse: collapse; width: 100%; margin: 20px 0; }
        th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
        th { background-color: #f2f2f2; }
        .status-active { color: #27ae60; }
        .status-warning { color: #f39c12; }
        .status-critical { color: #e74c3c; }
        .status-unused { color: #95a5a6; }
        .summary { background-color: #ecf0f1; padding: 15px; border-radius: 5px; margin: 20px 0; }
    </style>
</head>
<body>
    <h1>🔍 Confluent Cloud API Key Audit Report</h1>
    <p>Generated on: <strong>$(date)</strong></p>
EOF
    
    # Add summary
    local total_keys=$(echo "$keys_data" | jq 'length')
    local active_keys=$(echo "$keys_data" | jq '[.[] | select(.status == "active")] | length')
    local warning_keys=$(echo "$keys_data" | jq '[.[] | select(.status == "warning")] | length')
    local critical_keys=$(echo "$keys_data" | jq '[.[] | select(.status == "critical")] | length')
    local unused_keys=$(echo "$keys_data" | jq '[.[] | select(.status == "unused")] | length')
    
    cat >> "$output_file" << EOF
    <div class="summary">
        <h2>Summary</h2>
        <ul>
            <li>Total Keys: <strong>$total_keys</strong></li>
            <li>Active Keys: <strong>$active_keys</strong></li>
            <li>Warning Keys: <strong>$warning_keys</strong></li>
            <li>Critical Keys: <strong>$critical_keys</strong></li>
            <li>Unused Keys: <strong>$unused_keys</strong></li>
        </ul>
    </div>
    
    <h2>API Key Details</h2>
    <table>
        <thead>
            <tr>
                <th>API Key</th>
                <th>Description</th>
                <th>Resource ID</th>
                <th>Age (days)</th>
                <th>Status</th>
                <th>Last Used</th>
            </tr>
        </thead>
        <tbody>
EOF
    
    # Add table rows
    while IFS= read -r key_json; do
        local key=$(echo "$key_json" | jq -r '.key')
        local description=$(echo "$key_json" | jq -r '.description')
        local resource_id=$(echo "$key_json" | jq -r '.resource_id')
        local age_days=$(echo "$key_json" | jq -r '.age_days')
        local status=$(echo "$key_json" | jq -r '.status')
        local last_used=$(echo "$key_json" | jq -r '.last_used // "Never"')
        
        cat >> "$output_file" << EOF
            <tr>
                <td>$key</td>
                <td>$description</td>
                <td>$resource_id</td>
                <td>$age_days</td>
                <td><span class="status-$status">$status</span></td>
                <td>$last_used</td>
            </tr>
EOF
    done < <(echo "$keys_data" | jq -c '.[]')
    
    cat >> "$output_file" << 'EOF'
        </tbody>
    </table>
</body>
</html>
EOF
    
    success "HTML report saved to: $output_file"
}

# Output audit results
output_audit_results() {
    local keys_data="$1"
    
    case "$(echo "$OUTPUT_FORMAT" | tr '[:upper:]' '[:lower:]')" in
        json)
            if [[ -n "$REPORT_FILE" ]]; then
                echo "$keys_data" | jq . > "$REPORT_FILE"
                success "JSON report saved to: $REPORT_FILE"
            else
                echo "$keys_data" | jq .
            fi
            ;;
        csv)
            local csv_output="key,description,resource_id,created_date,age_days,status,last_used,permissions"$'\n'
            
            if command_exists jq; then
                while IFS= read -r key_json; do
                    local key=$(echo "$key_json" | jq -r '.key')
                    local description=$(echo "$key_json" | jq -r '.description')
                    local resource_id=$(echo "$key_json" | jq -r '.resource_id')
                    local created_date=$(echo "$key_json" | jq -r '.created_date // ""')
                    local age_days=$(echo "$key_json" | jq -r '.age_days')
                    local status=$(echo "$key_json" | jq -r '.status')
                    local last_used=$(echo "$key_json" | jq -r '.last_used // ""')
                    local permissions=$(echo "$key_json" | jq -r '.permissions // ""')
                    
                    csv_output+="$key,\"$description\",$resource_id,$created_date,$age_days,$status,$last_used,\"$permissions\""$'\n'
                done < <(echo "$keys_data" | jq -c '.[]')
            fi
            
            if [[ -n "$REPORT_FILE" ]]; then
                echo "$csv_output" > "$REPORT_FILE"
                success "CSV report saved to: $REPORT_FILE"
            else
                echo "$csv_output"
            fi
            ;;
        yaml)
            if command_exists yq; then
                local yaml_output
                yaml_output=$(echo "$keys_data" | yq .)
            else
                local yaml_output="# YAML output requires yq"$'\n'"keys:"
                if command_exists jq; then
                    while IFS= read -r key_json; do
                        local key=$(echo "$key_json" | jq -r '.key')
                        local status=$(echo "$key_json" | jq -r '.status')
                        yaml_output+=$'\n'"  - key: $key"$'\n'"    status: $status"
                    done < <(echo "$keys_data" | jq -c '.[]')
                fi
            fi
            
            if [[ -n "$REPORT_FILE" ]]; then
                echo "$yaml_output" > "$REPORT_FILE"
                success "YAML report saved to: $REPORT_FILE"
            else
                echo "$yaml_output"
            fi
            ;;
        html)
            if [[ -n "$REPORT_FILE" ]]; then
                output_html_format "$keys_data" "$REPORT_FILE"
            else
                error "HTML output requires --report-file option"
                return 1
            fi
            ;;
        table|*)
            output_table_format "$keys_data"
            ;;
    esac
}

# Main function
main() {
    # Initialize
    init_common
    
    # Parse arguments
    parse_args "$@"
    
    # Set defaults
    OUTPUT_FORMAT="${OUTPUT_FORMAT:-$DEFAULT_OUTPUT_FORMAT}"
    FILTER_TYPE="${FILTER_TYPE:-all}"
    AGE_WARNING_DAYS="${AGE_WARNING_DAYS:-$DEFAULT_AGE_WARNING_DAYS}"
    AGE_CRITICAL_DAYS="${AGE_CRITICAL_DAYS:-$DEFAULT_AGE_CRITICAL_DAYS}"
    SUMMARY_ONLY="${SUMMARY_ONLY:-false}"
    DETAILED_ANALYSIS="${DETAILED_ANALYSIS:-false}"
    ANALYZE_UNUSED="${ANALYZE_UNUSED:-false}"
    ANALYZE_PERMISSIONS="${ANALYZE_PERMISSIONS:-false}"
    
    # Show header
    if ! is_quiet; then
        header "$SCRIPT_DESCRIPTION" "$AUDIT"
    fi
    
    # Load and validate configuration
    if ! init_config; then
        exit 1
    fi
    
    # Check prerequisites
    if ! check_prerequisites; then
        exit 1
    fi
    
    # Validate output format
    local valid_formats=("table" "json" "csv" "yaml" "html")
    local format_valid=false
    for format in "${valid_formats[@]}"; do
        if [[ "$(echo "$OUTPUT_FORMAT" | tr '[:upper:]' '[:lower:]')" == "$format" ]]; then
            format_valid=true
            break
        fi
    done
    
    if [[ "$format_valid" != "true" ]]; then
        error "Invalid output format: $OUTPUT_FORMAT"
        info "Valid formats: ${valid_formats[*]}"
        exit 1
    fi
    
    # Get API keys
    local raw_keys
    if ! raw_keys=$(get_api_keys); then
        exit 1
    fi
    
    if [[ -z "$raw_keys" || "$raw_keys" == "[]" ]]; then
        warning "No API keys found"
        exit 0
    fi
    
    debug "Raw keys retrieved successfully"
    
    # Process and enrich key data
    local processed_keys
    debug "Starting key processing"
    processed_keys=$(process_api_keys "$raw_keys")
    debug "Key processing completed"
    
    # Apply filters
    local filtered_keys
    filtered_keys=$(filter_keys "$processed_keys" "$FILTER_TYPE")
    
    # Check if we have processed keys
    if [[ -z "$processed_keys" ]] || [[ "$processed_keys" == "[]" ]] || ! echo "$processed_keys" | jq . >/dev/null 2>&1; then
        warning "No API keys found or failed to process key data"
        exit 0
    fi
    
    # Generate summary if requested or if no keys after filtering
    local filtered_count=$(echo "$filtered_keys" | jq 'length' 2>/dev/null || echo "0")
    if [[ "$SUMMARY_ONLY" == "true" ]] || [[ "$filtered_count" -eq 0 ]]; then
        generate_summary "$processed_keys"
        
        if [[ "$filtered_count" -eq 0 ]]; then
            info "No keys match the specified filter: $FILTER_TYPE"
            exit 0
        fi
        
        if [[ "$SUMMARY_ONLY" == "true" ]]; then
            exit 0
        fi
    fi
    
    # Output results
    if ! is_quiet && [[ "$OUTPUT_FORMAT" == "table" ]]; then
        echo
        header "API Key Audit Results (Filter: $FILTER_TYPE)" "$AUDIT"
    fi
    
    output_audit_results "$filtered_keys"
    
    # Show summary for non-summary modes
    if [[ "$SUMMARY_ONLY" != "true" ]] && ! is_quiet && [[ "$OUTPUT_FORMAT" == "table" ]]; then
        echo
        generate_summary "$processed_keys"
    fi
    
    success "Audit completed successfully"
}

# Run main function
main "$@"
