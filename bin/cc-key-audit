#!/bin/bash
# cc-key-audit - Simple API key audit utility for Confluent Cloud

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Emojis
AUDIT="🔍"
SUCCESS="✅"
WARNING="⚠️"
ERROR="❌"
INFO="ℹ️"

# Script metadata
SCRIPT_NAME="cc-key-audit"
SCRIPT_VERSION="1.0.0"
SCRIPT_DESCRIPTION="Simple API key audit utility for Confluent Cloud"

# Default output format
OUTPUT_FORMAT="table"

# Usage function
usage() {
    cat << EOF
${BLUE}${AUDIT} $SCRIPT_NAME v$SCRIPT_VERSION${NC}
$SCRIPT_DESCRIPTION

${YELLOW}Usage:${NC}
  $SCRIPT_NAME [OPTIONS]

${YELLOW}Options:${NC}
  -o, --output FORMAT         Output format (table, json, csv)
  -h, --help                 Show this help message

${YELLOW}Examples:${NC}
  $SCRIPT_NAME                           # Basic audit with table output
  $SCRIPT_NAME -o json                   # JSON output
  $SCRIPT_NAME -o csv                    # CSV output

EOF
}

# Parse command line arguments
parse_args() {
    while [[ $# -gt 0 ]]; do
        case $1 in
            -o|--output)
                OUTPUT_FORMAT="$2"
                shift 2
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            *)
                echo -e "${ERROR} Unknown option: $1"
                usage
                exit 1
                ;;
        esac
    done
}

# Check if command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# Print colored output
print_status() {
    local level="$1"
    local message="$2"
    
    case "$level" in
        success)
            echo -e "${SUCCESS} ${GREEN}SUCCESS:${NC} $message"
            ;;
        warning)
            echo -e "${WARNING} ${YELLOW}WARNING:${NC} $message"
            ;;
        error)
            echo -e "${ERROR} ${RED}ERROR:${NC} $message"
            ;;
        info)
            echo -e "${INFO} ${BLUE}INFO:${NC} $message"
            ;;
        *)
            echo "$message"
            ;;
    esac
}

# Get all API keys
get_api_keys() {
    if ! command_exists confluent; then
        print_status error "confluent CLI not found"
        return 1
    fi
    
    local output
    if output=$(confluent api-key list --output json 2>&1); then
        echo "$output"
    else
        print_status error "Failed to retrieve API keys: $output"
        return 1
    fi
}

# Calculate simple age in days
calculate_age() {
    local created_date="$1"
    local date_part="${created_date%%T*}"
    
    if [[ "$date_part" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
        local year="${date_part:0:4}"
        local month="${date_part:5:2}"
        local day="${date_part:8:2}"
        
        local current_date=$(date +%Y-%m-%d)
        local current_year="${current_date:0:4}"
        local current_month="${current_date:5:2}"
        local current_day="${current_date:8:2}"
        
        local created_days=$(( (year - 2020) * 365 + (month - 1) * 30 + day ))
        local current_days=$(( (current_year - 2020) * 365 + (current_month - 1) * 30 + current_day ))
        local age_days=$((current_days - created_days))
        
        if [[ $age_days -lt 0 ]]; then
            echo "0"
        else
            echo "$age_days"
        fi
    else
        echo "0"
    fi
}

# Output table format
output_table() {
    local keys_data="$1"
    
    if ! command_exists jq; then
        print_status error "jq required for processing"
        return 1
    fi
    
    local count=$(echo "$keys_data" | jq 'length' 2>/dev/null || echo "0")
    
    if [[ "$count" -eq 0 ]]; then
        echo
        print_status warning "No API keys found"
        return
    fi
    
    # Calculate statistics
    local kafka_count=$(echo "$keys_data" | jq '[.[] | select(.resource_type == "kafka")] | length' 2>/dev/null || echo "0")
    local sr_count=$(echo "$keys_data" | jq '[.[] | select(.resource_type == "schema-registry")] | length' 2>/dev/null || echo "0")
    local cloud_count=$(echo "$keys_data" | jq '[.[] | select(.resource_type == "cloud")] | length' 2>/dev/null || echo "0")
    local flink_count=$(echo "$keys_data" | jq '[.[] | select(.resource_type == "flink-region")] | length' 2>/dev/null || echo "0")
    local old_keys=$(echo "$keys_data" | jq '[.[] | select((if .created then (now - (.created | fromdateiso8601)) / 86400 | floor else 0 end) > 90)] | length' 2>/dev/null || echo "0")
    local very_old_keys=$(echo "$keys_data" | jq '[.[] | select((if .created then (now - (.created | fromdateiso8601)) / 86400 | floor else 0 end) > 365)] | length' 2>/dev/null || echo "0")
    
    # Display summary box (72 chars wide)
    echo
    echo -e "${BLUE}╔════════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${BLUE}║${NC}                   🔍 API Key Audit Summary                          ${BLUE}║${NC}"
    echo -e "${BLUE}╠════════════════════════════════════════════════════════════════════════╣${NC}"
    
    # Format numbers with padding
    local total_str=$(printf "%-2s" "$count")
    local kafka_str=$(printf "%-2s" "$kafka_count")
    local sr_str=$(printf "%-2s" "$sr_count")
    local cloud_str=$(printf "%-2s" "$cloud_count")
    local flink_str=$(printf "%-2s" "$flink_count")
    local old_str=$(printf "%-2s" "$old_keys")
    
    # Line 1: Total Keys: XX  │  Kafka: X   │  Schema Registry: X
    echo -e "${BLUE}║${NC}  ${GREEN}Total Keys:${NC} ${total_str}       ${BLUE}│${NC}  ${YELLOW}Kafka:${NC} ${kafka_str}   ${BLUE}│${NC}  ${YELLOW}Schema Registry:${NC} ${sr_str}        ${BLUE}║${NC}"
    # Line 2: Cloud: X         │  Flink: X   │  Old (>90d): X
    echo -e "${BLUE}║${NC}  ${YELLOW}Cloud:${NC} ${cloud_str}           ${BLUE}│${NC}  ${YELLOW}Flink:${NC} ${flink_str}   ${BLUE}│${NC}  ${RED}Old (>90d):${NC} ${old_str}             ${BLUE}║${NC}"
    echo -e "${BLUE}╚════════════════════════════════════════════════════════════════════════╝${NC}"
    echo
    
    # Display keys table
    echo -e "${BLUE}┌────────────────────┬─────────────────┬──────────────────────────────────────────┬──────────┐${NC}"
    printf "${BLUE}│${NC} %-18s ${BLUE}│${NC} %-15s ${BLUE}│${NC} %-40s ${BLUE}│${NC} %-8s ${BLUE}│${NC}\n" "Key" "Type" "Description" "Age"
    echo -e "${BLUE}├────────────────────┼─────────────────┼──────────────────────────────────────────┼──────────┤${NC}"
    
    echo "$keys_data" | jq -r '.[] | [.key[0:18], .resource_type[0:15], .description[0:40], (if .created then (now - (.created | fromdateiso8601)) / 86400 | floor else 0 end)] | @tsv' 2>/dev/null | \
    while IFS=$'\t' read -r key type desc age; do
        # Truncate/pad to exact widths
        key=$(printf "%-18.18s" "$key")
        type=$(printf "%-15.15s" "$type")
        desc=$(printf "%-40.40s" "$desc")
        
        # Determine age display and warning
        local age_display="${age}d"
        local age_warning=""
        if [[ $age -gt 365 ]]; then
            age_warning="⚠️ "
        elif [[ $age -gt 90 ]]; then
            age_warning="⚠️ "
        fi
        
        # Color code by type
        local type_color="${NC}"
        case "$type" in
            kafka)
                type_color="${GREEN}"
                ;;
            schema-registry)
                type_color="${BLUE}"
                ;;
            cloud)
                type_color="${YELLOW}"
                ;;
            flink-region)
                type_color="${BLUE}"
                ;;
        esac
        
        # Color code by age
        local age_color="${GREEN}"
        if [[ $age -gt 365 ]]; then
            age_color="${RED}"
        elif [[ $age -gt 90 ]]; then
            age_color="${YELLOW}"
        fi
        
        # Format age field to exactly 8 characters
        local age_field=$(printf "%-5s" "$age_display")
        if [[ -n "$age_warning" ]]; then
            age_field="${age_field}${age_warning}"
        else
            age_field=$(printf "%-8s" "$age_field")
        fi
        
        # Print row with colors applied AFTER padding
        echo -e "${BLUE}│${NC} ${key} ${BLUE}│${NC} ${type_color}${type}${NC} ${BLUE}│${NC} ${desc} ${BLUE}│${NC} ${age_color}${age_field}${NC} ${BLUE}│${NC}"
    done
    
    echo -e "${BLUE}└────────────────────┴─────────────────┴──────────────────────────────────────────┴──────────┘${NC}"
    echo
    
    # Display warnings if needed
    if [[ $very_old_keys -gt 0 ]]; then
        print_status warning "Found $very_old_keys key(s) older than 1 year - consider rotating"
    fi
    
    if [[ $old_keys -gt 0 ]] && [[ $very_old_keys -eq 0 ]]; then
        print_status info "Found $old_keys key(s) older than 90 days"
    fi
    
    print_status success "Audit completed - $count API keys analyzed"
}

# Output JSON format
output_json() {
    local keys_data="$1"
    echo "$keys_data" | jq .
}

# Output CSV format
output_csv() {
    local keys_data="$1"
    
    echo "key,description,resource_type,resource_id,created_date,age_days"
    
    echo "$keys_data" | jq -r '.[] | [.key, .description, .resource_type, .resource, .created, (if .created then (now - (.created | fromdateiso8601)) / 86400 | floor else 0 end)] | @csv' 2>/dev/null
}

# Main function
main() {
    # Parse arguments
    parse_args "$@"
    
    # Show header (72 chars wide)
    echo
    echo -e "${BLUE}╔════════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${BLUE}║${NC}        🔍 Confluent Cloud API Key Audit v${SCRIPT_VERSION}                  ${BLUE}║${NC}"
    echo -e "${BLUE}╚════════════════════════════════════════════════════════════════════════╝${NC}"
    echo
    
    # Check prerequisites
    echo -e "${INFO} ${BLUE}Checking prerequisites...${NC}"
    
    if ! command_exists confluent; then
        print_status error "confluent CLI not found. Please install it first."
        exit 1
    fi
    print_status success "confluent CLI found"
    
    if ! command_exists jq; then
        print_status error "jq not found. Please install it first."
        exit 1
    fi
    print_status success "jq found"
    
    # Check if authenticated by trying to list environments
    echo
    echo -e "${INFO} ${BLUE}Verifying authentication...${NC}"
    if ! confluent environment list >/dev/null 2>&1; then
        print_status error "confluent CLI not authenticated. Please run 'confluent login' first."
        exit 1
    fi
    print_status success "Authentication verified"
    
    # Get API keys
    echo
    echo -e "${INFO} ${BLUE}Retrieving API keys...${NC}"
    local keys_data
    if ! keys_data=$(get_api_keys); then
        exit 1
    fi
    
    if [[ -z "$keys_data" || "$keys_data" == "[]" ]]; then
        echo
        print_status warning "No API keys found"
        exit 0
    fi
    
    local key_count=$(echo "$keys_data" | jq 'length' 2>/dev/null || echo "0")
    print_status success "Retrieved $key_count API keys"
    
    # Output results based on format
    case "$(echo "$OUTPUT_FORMAT" | tr '[:upper:]' '[:lower:]')" in
        json)
            echo
            output_json "$keys_data"
            ;;
        csv)
            echo
            output_csv "$keys_data"
            ;;
        table|*)
            output_table "$keys_data"
            ;;
    esac
}

# Run main function
main "$@"
