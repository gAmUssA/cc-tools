#!/bin/bash
# cc-property-files - Kafka property file generator for Confluent Cloud

# Get script directory and source shared libraries
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="$(dirname "$SCRIPT_DIR")/lib"

source "$LIB_DIR/common.sh"
source "$LIB_DIR/config.sh"
source "$LIB_DIR/validation.sh"
source "$LIB_DIR/output.sh"

# Script metadata
SCRIPT_NAME="cc-property-files"
SCRIPT_VERSION="1.0.0"
SCRIPT_DESCRIPTION="Kafka property file generator for Confluent Cloud"

# Default values
DEFAULT_OUTPUT_DIR="properties"

# Usage function
usage() {
    cat << EOF
${BLUE}${GEAR} $SCRIPT_NAME v$SCRIPT_VERSION${RESET}
$SCRIPT_DESCRIPTION

${YELLOW}Usage:${RESET}
  $SCRIPT_NAME [OPTIONS]

${YELLOW}Options:${RESET}
  -t, --type TYPE             Property type (producer, consumer, connect, ksql, sr)
  -o, --output-dir DIR        Output directory (default: $DEFAULT_OUTPUT_DIR)
  -e, --env-file FILE         Environment file path (default: .env)
  -q, --quiet                 Suppress non-essential output
  -v, --verbose               Increase output verbosity
  -n, --dry-run              Show what would be generated
  -r, --overwrite            Overwrite existing files
  -a, --all                  Generate all property types
  -h, --help                 Show this help message

${YELLOW}Examples:${RESET}
  $SCRIPT_NAME -t producer               # Generate producer properties
  $SCRIPT_NAME -a                        # Generate all property files
  $SCRIPT_NAME -t consumer -o /tmp       # Consumer props to /tmp

${YELLOW}Property Types:${RESET}
  producer        Kafka producer properties
  consumer        Kafka consumer properties
  connect         Kafka Connect worker properties
  flink           Flink SQL properties
  sr              Schema Registry properties

EOF
}

# Parse command line arguments
parse_args() {
    while [[ $# -gt 0 ]]; do
        case $1 in
            -t|--type)
                PROPERTY_TYPE="$2"
                shift 2
                ;;
            -o|--output-dir)
                OUTPUT_DIR="$2"
                shift 2
                ;;
            -e|--env-file)
                CC_ENV_FILE="$2"
                shift 2
                ;;
            -q|--quiet)
                CC_QUIET="true"
                shift
                ;;
            -v|--verbose)
                CC_VERBOSE="true"
                shift
                ;;
            -n|--dry-run)
                CC_DRY_RUN="true"
                shift
                ;;
            -r|--overwrite)
                OVERWRITE="true"
                shift
                ;;
            -a|--all)
                GENERATE_ALL="true"
                shift
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            *)
                error "Unknown option: $1"
                usage
                exit 1
                ;;
        esac
    done
}

# Generate producer properties
generate_producer_properties() {
    local output_file="$1"
    
    progress "Generating producer properties"
    
    cat > "$output_file" << EOF
# Generated by $SCRIPT_NAME on $(date)
# Kafka Producer Properties for Confluent Cloud

# Connection Configuration
bootstrap.servers=${CONFLUENT_BOOTSTRAP_SERVERS}
security.protocol=SASL_SSL
sasl.mechanism=PLAIN
sasl.jaas.config=org.apache.kafka.common.security.plain.PlainLoginModule required \\
    username='${CONFLUENT_CLOUD_API_KEY}' \\
    password='${CONFLUENT_CLOUD_API_SECRET}';

# Producer Configuration
client.id=${CONFLUENT_CLIENT_ID:-cc-tools-producer}
acks=all
retries=2147483647
max.in.flight.requests.per.connection=5
enable.idempotence=true
compression.type=snappy
batch.size=16384
linger.ms=5
buffer.memory=33554432
max.request.size=1048576

# Timeout Configuration
request.timeout.ms=30000
delivery.timeout.ms=120000
retry.backoff.ms=100

# Monitoring
metric.reporters=
metrics.sample.window.ms=30000
metrics.num.samples=2

EOF
    
    success "Generated producer properties: $output_file"
}

# Generate consumer properties
generate_consumer_properties() {
    local output_file="$1"
    
    progress "Generating consumer properties"
    
    cat > "$output_file" << EOF
# Generated by $SCRIPT_NAME on $(date)
# Kafka Consumer Properties for Confluent Cloud

# Connection Configuration
bootstrap.servers=${CONFLUENT_BOOTSTRAP_SERVERS}
security.protocol=SASL_SSL
sasl.mechanism=PLAIN
sasl.jaas.config=org.apache.kafka.common.security.plain.PlainLoginModule required \\
    username='${CONFLUENT_CLOUD_API_KEY}' \\
    password='${CONFLUENT_CLOUD_API_SECRET}';

# Consumer Configuration
client.id=${CONFLUENT_CLIENT_ID:-cc-tools-consumer}
group.id=${CONFLUENT_CONSUMER_GROUP:-cc-tools-consumer-group}
auto.offset.reset=earliest
enable.auto.commit=true
auto.commit.interval.ms=5000

# Session Configuration
session.timeout.ms=30000
heartbeat.interval.ms=3000
max.poll.records=500
max.poll.interval.ms=300000

# Fetch Configuration
fetch.min.bytes=1
fetch.max.wait.ms=500
max.partition.fetch.bytes=1048576

# Monitoring
metric.reporters=
metrics.sample.window.ms=30000
metrics.num.samples=2

EOF
    
    success "Generated consumer properties: $output_file"
}

# Generate Connect worker properties
generate_connect_properties() {
    local output_file="$1"
    
    progress "Generating Connect worker properties"
    
    cat > "$output_file" << EOF
# Generated by $SCRIPT_NAME on $(date)
# Kafka Connect Worker Properties for Confluent Cloud

# Connection Configuration
bootstrap.servers=${CONFLUENT_BOOTSTRAP_SERVERS}
security.protocol=SASL_SSL
sasl.mechanism=PLAIN
sasl.jaas.config=org.apache.kafka.common.security.plain.PlainLoginModule required \\
    username='${CONFLUENT_CLOUD_API_KEY}' \\
    password='${CONFLUENT_CLOUD_API_SECRET}';

# Connect Configuration
group.id=${CONFLUENT_CONNECT_GROUP:-cc-tools-connect-cluster}
key.converter=org.apache.kafka.connect.json.JsonConverter
value.converter=org.apache.kafka.connect.json.JsonConverter
key.converter.schemas.enable=false
value.converter.schemas.enable=false

# Internal Topics
config.storage.topic=${CONFLUENT_CONNECT_GROUP:-cc-tools-connect-cluster}-configs
offset.storage.topic=${CONFLUENT_CONNECT_GROUP:-cc-tools-connect-cluster}-offsets
status.storage.topic=${CONFLUENT_CONNECT_GROUP:-cc-tools-connect-cluster}-status

# Replication Factors
config.storage.replication.factor=3
offset.storage.replication.factor=3
status.storage.replication.factor=3

# REST API
rest.port=8083
rest.host.name=localhost

# Plugin Path
plugin.path=/usr/share/java,/usr/share/confluent-hub-components

EOF
    
    success "Generated Connect worker properties: $output_file"
}

# Generate Flink SQL properties
generate_flink_properties() {
    local output_file="$1"
    
    progress "Generating Flink SQL properties"
    
    cat > "$output_file" << EOF
# Generated by $SCRIPT_NAME on $(date)
# Flink SQL Properties for Confluent Cloud

# Connection Configuration
bootstrap.servers=${CONFLUENT_BOOTSTRAP_SERVERS}
security.protocol=SASL_SSL
sasl.mechanism=PLAIN
sasl.jaas.config=org.apache.kafka.common.security.plain.PlainLoginModule required \\
    username='${CONFLUENT_CLOUD_API_KEY}' \\
    password='${CONFLUENT_CLOUD_API_SECRET}';

# Flink Configuration
flink.region=${CONFLUENT_REGION}
flink.cloud=${CONFLUENT_CLOUD}

EOF

    if [[ -n "$CONFLUENT_SCHEMA_REGISTRY_URL" ]]; then
        cat >> "$output_file" << EOF
# Schema Registry Configuration
schema.registry.url=${CONFLUENT_SCHEMA_REGISTRY_URL}
schema.registry.basic.auth.user.info=${CONFLUENT_SCHEMA_REGISTRY_API_KEY}:${CONFLUENT_SCHEMA_REGISTRY_API_SECRET}

EOF
    fi
    
    success "Generated Flink SQL properties: $output_file"
}


# Generate Schema Registry properties
generate_schema_registry_properties() {
    local output_file="$1"
    
    if [[ -z "$CONFLUENT_SCHEMA_REGISTRY_URL" ]]; then
        warning "Schema Registry not configured, skipping"
        return 0
    fi
    
    progress "Generating Schema Registry properties"
    
    cat > "$output_file" << EOF
# Generated by $SCRIPT_NAME on $(date)
# Schema Registry Properties for Confluent Cloud

# Connection Configuration
kafkastore.bootstrap.servers=${CONFLUENT_BOOTSTRAP_SERVERS}
kafkastore.security.protocol=SASL_SSL
kafkastore.sasl.mechanism=PLAIN
kafkastore.sasl.jaas.config=org.apache.kafka.common.security.plain.PlainLoginModule required \\
    username='${CONFLUENT_CLOUD_API_KEY}' \\
    password='${CONFLUENT_CLOUD_API_SECRET}';

# Schema Registry Configuration
listeners=http://0.0.0.0:8081
kafkastore.topic=_schemas
kafkastore.topic.replication.factor=3

# Compatibility
schema.compatibility.level=BACKWARD

EOF
    
    success "Generated Schema Registry properties: $output_file"
}

# Generate all property files
generate_all_properties() {
    local output_dir="$1"
    
    header "Generating All Property Files" "$GEAR"
    
    local types=("producer" "consumer" "connect" "flink" "sr")
    local success_count=0
    local failure_count=0
    
    for type in "${types[@]}"; do
        echo
        if generate_property_file "$type" "$output_dir"; then
            ((success_count++))
        else
            ((failure_count++))
        fi
    done
    
    echo
    header "Generation Summary" "$CHECK"
    
    display_key_value \
        "Total Types=${#types[@]}" \
        "Successful=$success_count" \
        "Failed=$failure_count"
    
    return $failure_count
}

# Generate property file for specific type
generate_property_file() {
    local type="$1"
    local output_dir="$2"
    
    local filename
    case "$type" in
        producer)
            filename="producer.properties"
            ;;
        consumer)
            filename="consumer.properties"
            ;;
        connect)
            filename="connect-worker.properties"
            ;;
        flink)
            filename="flink-sql.properties"
            ;;
        sr)
            filename="schema-registry.properties"
            ;;
        *)
            error "Unknown property type: $type"
            return 1
            ;;
    esac
    
    local output_file="$output_dir/$filename"
    
    if [[ -f "$output_file" && "$OVERWRITE" != "true" ]]; then
        warning "File exists: $output_file (use --overwrite to replace)"
        return 0
    fi
    
    if is_dry_run; then
        info "DRY RUN: Would create $output_file"
        return 0
    fi
    
    mkdir -p "$output_dir"
    
    case "$type" in
        producer)
            generate_producer_properties "$output_file"
            ;;
        consumer)
            generate_consumer_properties "$output_file"
            ;;
        connect)
            generate_connect_properties "$output_file"
            ;;
        flink)
            generate_flink_properties "$output_file"
            ;;
        sr)
            generate_schema_registry_properties "$output_file"
            ;;
    esac
}

# Main function
main() {
    # Initialize
    init_common
    
    # Parse arguments
    parse_args "$@"
    
    # Set defaults
    OUTPUT_DIR="${OUTPUT_DIR:-$DEFAULT_OUTPUT_DIR}"
    OVERWRITE="${OVERWRITE:-false}"
    GENERATE_ALL="${GENERATE_ALL:-false}"
    
    # Show header
    if ! is_quiet; then
        header "$SCRIPT_DESCRIPTION" "$GEAR"
    fi
    
    # Load and validate configuration
    if ! init_config; then
        exit 1
    fi
    
    # Create output directory
    if ! is_dry_run; then
        if ! mkdir -p "$OUTPUT_DIR"; then
            error "Failed to create output directory: $OUTPUT_DIR"
            exit 1
        fi
    fi
    
    # Generate properties
    if [[ "$GENERATE_ALL" == "true" ]]; then
        generate_all_properties "$OUTPUT_DIR"
        exit_code=$?
    else
        if [[ -z "$PROPERTY_TYPE" ]]; then
            error "Property type required (use -t or --all)"
            usage
            exit 1
        fi
        
        generate_property_file "$PROPERTY_TYPE" "$OUTPUT_DIR"
        exit_code=$?
    fi
    
    if [[ $exit_code -eq 0 ]]; then
        success "Property file generation completed"
        
        if ! is_quiet && ! is_dry_run; then
            echo
            info "Generated property files in: $OUTPUT_DIR"
            if command_exists find; then
                find "$OUTPUT_DIR" -name "*.properties" | while read -r file; do
                    echo -e "  ${GREEN}${CHECK}${RESET} $file"
                done
            fi
        fi
    else
        error "Property file generation failed"
        exit 1
    fi
}

# Run main function
main "$@"
