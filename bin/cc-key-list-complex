#!/bin/bash
# cc-key-list - API key inventory management with deletion capabilities

# Get script directory and source shared libraries
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="$(dirname "$SCRIPT_DIR")/lib"

source "$LIB_DIR/common.sh"
source "$LIB_DIR/config.sh"
source "$LIB_DIR/validation.sh"
source "$LIB_DIR/output.sh"

# Script metadata
SCRIPT_NAME="cc-key-list"
SCRIPT_VERSION="1.0.0"
SCRIPT_DESCRIPTION="API key inventory management with deletion capabilities"

# Default values
DEFAULT_OUTPUT_FORMAT="table"
DEFAULT_FILTER="all"
DEFAULT_AGE_THRESHOLD="90"

# Usage function
usage() {
    cat << EOF
${BLUE}${KEY} $SCRIPT_NAME v$SCRIPT_VERSION${RESET}
$SCRIPT_DESCRIPTION

${YELLOW}Usage:${RESET}
  $SCRIPT_NAME [OPTIONS]

${YELLOW}Options:${RESET}
  -o, --output FORMAT         Output format (table, json, csv, yaml)
  -f, --filter FILTER         Filter keys (all, active, old, resource-type)
  -a, --age-threshold DAYS    Age threshold for 'old' filter (default: 90)
  -r, --resource-type TYPE    Filter by resource type (kafka, schema-registry, ksql, connect)
  -d, --delete                Enable interactive deletion mode
  -b, --bulk-delete           Enable bulk deletion mode
  -e, --env-file FILE         Environment file path (default: .env)
  -q, --quiet                 Suppress non-essential output
  -v, --verbose               Increase output verbosity
  -n, --dry-run              Show what would be deleted without actual deletion
  --export-file FILE          Export inventory to file
  -h, --help                 Show this help message

${YELLOW}Examples:${RESET}
  $SCRIPT_NAME                           # List all keys in table format
  $SCRIPT_NAME -o json                   # List keys in JSON format
  $SCRIPT_NAME -f old -a 60              # Show keys older than 60 days
  $SCRIPT_NAME -r kafka                  # Show only Kafka cluster keys
  $SCRIPT_NAME -d                        # Interactive deletion mode
  $SCRIPT_NAME -b --dry-run              # Bulk delete preview
  $SCRIPT_NAME --export-file keys.csv    # Export to CSV file

${YELLOW}Filter Options:${RESET}
  all         All API keys (default)
  active      Recently used keys
  old         Keys older than age threshold
  kafka       Kafka cluster keys only
  sr          Schema Registry keys only
  ksql        ksqlDB keys only
  connect     Kafka Connect keys only

${YELLOW}Interactive Modes:${RESET}
  -d          Select individual keys for deletion
  -b          Select multiple keys for bulk deletion

EOF
}

# Parse command line arguments
parse_args() {
    while [[ $# -gt 0 ]]; do
        case $1 in
            -o|--output)
                OUTPUT_FORMAT="$2"
                shift 2
                ;;
            -f|--filter)
                FILTER="$2"
                shift 2
                ;;
            -a|--age-threshold)
                AGE_THRESHOLD="$2"
                shift 2
                ;;
            -r|--resource-type)
                RESOURCE_TYPE="$2"
                shift 2
                ;;
            -d|--delete)
                DELETE_MODE="true"
                shift
                ;;
            -b|--bulk-delete)
                BULK_DELETE="true"
                shift
                ;;
            -e|--env-file)
                CC_ENV_FILE="$2"
                shift 2
                ;;
            -q|--quiet)
                CC_QUIET="true"
                shift
                ;;
            -v|--verbose)
                CC_VERBOSE="true"
                shift
                ;;
            -n|--dry-run)
                CC_DRY_RUN="true"
                shift
                ;;
            --export-file)
                EXPORT_FILE="$2"
                shift 2
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            *)
                error "Unknown option: $1"
                usage
                exit 1
                ;;
        esac
    done
}

# Get API keys with metadata
get_api_keys() {
    progress "Retrieving API key inventory"
    
    local keys_json
    if ! keys_json=$(confluent api-key list -o json 2>/dev/null); then
        error "Failed to retrieve API keys"
        return 1
    fi
    
    if [[ -z "$keys_json" || "$keys_json" == "[]" ]]; then
        warning "No API keys found"
        return 1
    fi
    
    # Debug: Check if JSON is valid
    if ! echo "$keys_json" | jq . >/dev/null 2>&1; then
        error "Invalid JSON received from confluent CLI"
        debug "Raw output: $keys_json"
        return 1
    fi
    
    echo "$keys_json"
}

# Calculate key age in days
calculate_key_age() {
    local created_date="$1"
    
    if [[ -z "$created_date" ]]; then
        echo "unknown"
        return
    fi
    
    # Convert date to epoch (handle different date formats)
    local created_epoch
    if command_exists gdate; then
        created_epoch=$(gdate -d "$created_date" +%s 2>/dev/null)
    else
        created_epoch=$(date -j -f "%Y-%m-%dT%H:%M:%S" "${created_date%.*}" +%s 2>/dev/null)
    fi
    
    if [[ -z "$created_epoch" ]]; then
        echo "unknown"
        return
    fi
    
    local current_epoch=$(date +%s)
    local age_seconds=$((current_epoch - created_epoch))
    local age_days=$((age_seconds / 86400))
    
    echo "$age_days"
}

# Filter keys based on criteria
filter_keys() {
    local keys_json="$1"
    local filter="$2"
    
    case "$filter" in
        all)
            echo "$keys_json"
            ;;
        old)
            echo "$keys_json" | jq --arg threshold "$AGE_THRESHOLD" '
                map(select(
                    .created and 
                    ((now - ((.created | split("T")[0] | strptime("%Y-%m-%d")) | mktime)) / 86400) > ($threshold | tonumber)
                ))'
            ;;
        kafka)
            echo "$keys_json" | jq 'map(select(.resource and (.resource | startswith("lkc-"))))'
            ;;
        sr|schema-registry)
            echo "$keys_json" | jq 'map(select(.resource and (.resource | startswith("lsrc-"))))'
            ;;
        ksql)
            echo "$keys_json" | jq 'map(select(.resource and (.resource | startswith("lksqlc-"))))'
            ;;
        connect)
            echo "$keys_json" | jq 'map(select(.resource and (.resource | startswith("lcc-"))))'
            ;;
        *)
            if [[ -n "$RESOURCE_TYPE" ]]; then
                filter_keys "$keys_json" "$RESOURCE_TYPE"
            else
                echo "$keys_json"
            fi
            ;;
    esac
}

# Display keys in table format
display_keys_table() {
    local keys_json="$1"
    
    if [[ -z "$keys_json" || "$keys_json" == "[]" ]]; then
        info "No keys match the specified criteria"
        return 0
    fi
    
    # Create table header
    printf "${CYAN}%-3s %-20s %-15s %-12s %-8s %-30s${RESET}\n" \
        "#" "API Key" "Resource ID" "Resource Type" "Age (days)" "Description"
    printf "${BLUE}%s${RESET}\n" "$(printf '%.100s' "$(printf '%*s' 100 '' | tr ' ' '-')")"
    
    # Process and display each key
    local index=1
    local length=$(echo "$keys_json" | jq -r 'length')
    
    for ((i=0; i<length; i++)); do
        local key_info=$(echo "$keys_json" | jq -c ".[$i]")
        
        local api_key=$(echo "$key_info" | jq -r '.key // "N/A"')
        local resource_id=$(echo "$key_info" | jq -r '.resource // "N/A"')
        local description=$(echo "$key_info" | jq -r '.description // "N/A"')
        local created_date=$(echo "$key_info" | jq -r '.created // ""')
        local resource_type=$(echo "$key_info" | jq -r '.resource_type // "unknown"')
        
        local age=$(calculate_key_age "$created_date")
        
        # Truncate long values for table display
        local short_key="${api_key:0:18}${api_key:18:1:+...}"
        local short_resource="${resource_id:0:13}${resource_id:13:1:+...}"
        local short_desc="${description:0:28}${description:28:1:+...}"
        
        # Color code based on age
        local age_color="$GREEN"
        if [[ "$age" != "unknown" && "$age" -gt "$AGE_THRESHOLD" ]]; then
            age_color="$RED"
        elif [[ "$age" != "unknown" && "$age" -gt $((AGE_THRESHOLD / 2)) ]]; then
            age_color="$YELLOW"
        fi
        
        printf "%-3s %-20s %-15s %-12s ${age_color}%-8s${RESET} %-30s\n" \
            "$index" "$short_key" "$short_resource" "$resource_type" "$age" "$short_desc"
        
        ((index++))
    done
}

# Interactive key selection for deletion
interactive_delete() {
    local keys_json="$1"
    
    if [[ -z "$keys_json" || "$keys_json" == "[]" ]]; then
        warning "No keys available for deletion"
        return 0
    fi
    
    header "Interactive Key Deletion" "$TRASH"
    
    # Display keys with numbers
    display_keys_table "$keys_json"
    echo
    
    local total_keys=$(echo "$keys_json" | jq 'length')
    
    while true; do
        echo -e "${YELLOW}Select key to delete [1-$total_keys], 'q' to quit:${RESET}"
        read -p "> " selection
        
        if [[ "$selection" == "q" ]]; then
            info "Deletion cancelled"
            return 0
        fi
        
        if [[ "$selection" =~ ^[1-9][0-9]*$ ]] && [[ $selection -le $total_keys ]]; then
            local key_info
            key_info=$(echo "$keys_json" | jq -r ".[$((selection-1))]")
            
            local api_key=$(echo "$key_info" | jq -r '.key')
            local description=$(echo "$key_info" | jq -r '.description // "N/A"')
            local resource_id=$(echo "$key_info" | jq -r '.resource_id // "N/A"')
            
            echo
            warning "You are about to delete:"
            display_key_value \
                "API Key=$api_key" \
                "Description=$description" \
                "Resource ID=$resource_id"
            
            echo
            if confirm "Are you sure you want to delete this API key?"; then
                delete_api_key "$api_key"
            else
                info "Deletion cancelled"
            fi
            
            echo
            if ! confirm "Delete another key?"; then
                break
            fi
        else
            warning "Invalid selection. Please enter a number between 1 and $total_keys"
        fi
    done
}

# Bulk delete functionality
bulk_delete() {
    local keys_json="$1"
    
    if [[ -z "$keys_json" || "$keys_json" == "[]" ]]; then
        warning "No keys available for deletion"
        return 0
    fi
    
    header "Bulk Key Deletion" "$TRASH"
    
    display_keys_table "$keys_json"
    echo
    
    local total_keys=$(echo "$keys_json" | jq 'length')
    
    echo -e "${YELLOW}Select keys to delete (comma-separated, ranges like 1-3, or 'all'):${RESET}"
    read -p "> " selections
    
    if [[ "$selections" == "all" ]]; then
        warning "You are about to delete ALL $total_keys API keys!"
        if ! confirm "Are you absolutely sure?"; then
            info "Bulk deletion cancelled"
            return 0
        fi
        
        delete_all_keys "$keys_json"
    else
        # Parse selections (comma-separated and ranges)
        local selected_keys=()
        IFS=',' read -ra ADDR <<< "$selections"
        for selection in "${ADDR[@]}"; do
            selection=$(echo "$selection" | tr -d ' ')
            if [[ "$selection" =~ ^[0-9]+-[0-9]+$ ]]; then
                # Range like 1-3
                local start="${selection%-*}"
                local end="${selection#*-}"
                for ((i=start; i<=end; i++)); do
                    if [[ $i -le $total_keys ]]; then
                        selected_keys+=("$i")
                    fi
                done
            elif [[ "$selection" =~ ^[1-9][0-9]*$ ]]; then
                # Single number
                if [[ $selection -le $total_keys ]]; then
                    selected_keys+=("$selection")
                fi
            fi
        done
        
        if [[ ${#selected_keys[@]} -eq 0 ]]; then
            warning "No valid keys selected"
            return 0
        fi
        
        echo
        warning "You are about to delete ${#selected_keys[@]} API key(s):"
        for index in "${selected_keys[@]}"; do
            local key_info
            key_info=$(echo "$keys_json" | jq -r ".[$((index-1))]")
            local api_key=$(echo "$key_info" | jq -r '.key')
            local description=$(echo "$key_info" | jq -r '.description // "N/A"')
            echo -e "  ${RED}${CROSS}${RESET} $api_key - $description"
        done
        
        echo
        if confirm "Proceed with bulk deletion?"; then
            delete_selected_keys "$keys_json" "${selected_keys[@]}"
        else
            info "Bulk deletion cancelled"
        fi
    fi
}

# Delete a single API key
delete_api_key() {
    local api_key="$1"
    
    if is_dry_run; then
        info "DRY RUN: Would delete API key: $api_key"
        return 0
    fi
    
    progress "Deleting API key: $api_key"
    
    if confluent api-key delete "$api_key" --force >/dev/null 2>&1; then
        success "Successfully deleted API key: $api_key"
        return 0
    else
        error "Failed to delete API key: $api_key"
        return 1
    fi
}

# Delete all keys
delete_all_keys() {
    local keys_json="$1"
    
    local total_keys=$(echo "$keys_json" | jq 'length')
    local success_count=0
    local failure_count=0
    
    echo "$keys_json" | jq -r '.[].key' | while read -r api_key; do
        if delete_api_key "$api_key"; then
            ((success_count++))
        else
            ((failure_count++))
        fi
    done
    
    echo
    header "Bulk Deletion Summary" "$CHECK"
    display_key_value \
        "Total Keys=$total_keys" \
        "Successful=$success_count" \
        "Failed=$failure_count"
}

# Delete selected keys
delete_selected_keys() {
    local keys_json="$1"
    shift
    local selected_indices=("$@")
    
    local success_count=0
    local failure_count=0
    
    for index in "${selected_indices[@]}"; do
        local key_info
        key_info=$(echo "$keys_json" | jq -r ".[$((index-1))]")
        local api_key=$(echo "$key_info" | jq -r '.key')
        
        if delete_api_key "$api_key"; then
            ((success_count++))
        else
            ((failure_count++))
        fi
    done
    
    echo
    header "Deletion Summary" "$CHECK"
    display_key_value \
        "Selected=${#selected_indices[@]}" \
        "Successful=$success_count" \
        "Failed=$failure_count"
}

# Export keys to file
export_keys() {
    local keys_json="$1"
    local export_file="$2"
    local format="$3"
    
    if [[ -z "$export_file" ]]; then
        return 0
    fi
    
    progress "Exporting keys to: $export_file"
    
    case "$format" in
        json)
            echo "$keys_json" | jq . > "$export_file"
            ;;
        csv)
            {
                echo "api_key,resource_id,resource_type,description,created_date,age_days"
                echo "$keys_json" | jq -r '.[] | [.key, .resource_id, (.resource_id | if startswith("lkc-") then "kafka" elif startswith("lsrc-") then "schema-registry" elif startswith("lksqlc-") then "ksql" elif startswith("lcc-") then "connect" else "unknown" end), .description, .created_at, ""] | @csv'
            } > "$export_file"
            ;;
        yaml)
            if command_exists yq; then
                echo "$keys_json" | yq -P . > "$export_file"
            else
                echo "$keys_json" | jq . > "$export_file"
                warning "yq not found, exported as JSON instead"
            fi
            ;;
        *)
            echo "$keys_json" | jq . > "$export_file"
            ;;
    esac
    
    success "Keys exported to: $export_file"
}

# Main function
main() {
    # Initialize
    init_common
    
    # Parse arguments
    parse_args "$@"
    
    # Set defaults
    OUTPUT_FORMAT="${OUTPUT_FORMAT:-$DEFAULT_OUTPUT_FORMAT}"
    FILTER="${FILTER:-$DEFAULT_FILTER}"
    AGE_THRESHOLD="${AGE_THRESHOLD:-$DEFAULT_AGE_THRESHOLD}"
    DELETE_MODE="${DELETE_MODE:-false}"
    BULK_DELETE="${BULK_DELETE:-false}"
    
    # Show header
    if ! is_quiet; then
        header "$SCRIPT_DESCRIPTION" "$KEY"
    fi
    
    # Load and validate configuration
    if ! init_config; then
        exit 1
    fi
    
    # Check prerequisites
    if ! check_prerequisites; then
        exit 1
    fi
    
    # Get API keys
    local keys_json
    if ! keys_json=$(get_api_keys); then
        exit 1
    fi
    
    # Apply filters
    if [[ "$FILTER" != "all" || -n "$RESOURCE_TYPE" ]]; then
        local filter_type="${RESOURCE_TYPE:-$FILTER}"
        keys_json=$(filter_keys "$keys_json" "$filter_type")
    fi
    
    # Handle deletion modes
    if [[ "$DELETE_MODE" == "true" ]]; then
        interactive_delete "$keys_json"
        exit 0
    elif [[ "$BULK_DELETE" == "true" ]]; then
        bulk_delete "$keys_json"
        exit 0
    fi
    
    # Display or export results
    case "$(echo "$OUTPUT_FORMAT" | tr '[:upper:]' '[:lower:]')" in
        table)
            display_keys_table "$keys_json"
            ;;
        json)
            output_json "$keys_json"
            ;;
        csv)
            {
                echo "api_key,resource_id,resource_type,description,created_date,age_days"
                echo "$keys_json" | jq -r '.[] | [.key, .resource_id, (.resource_id | if startswith("lkc-") then "kafka" elif startswith("lsrc-") then "schema-registry" elif startswith("lksqlc-") then "ksql" elif startswith("lcc-") then "connect" else "unknown" end), .description, .created_at, ""] | @csv'
            }
            ;;
        yaml)
            output_yaml "$keys_json"
            ;;
        *)
            error "Invalid output format: $OUTPUT_FORMAT"
            exit 1
            ;;
    esac
    
    # Export if requested
    if [[ -n "$EXPORT_FILE" ]]; then
        export_keys "$keys_json" "$EXPORT_FILE" "$OUTPUT_FORMAT"
    fi
    
    # Show summary
    if ! is_quiet && [[ "$OUTPUT_FORMAT" == "table" ]]; then
        local total_keys=$(echo "$keys_json" | jq 'length')
        echo
        info "Total keys: $total_keys"
        
        if [[ "$total_keys" -gt 0 ]]; then
            echo -e "${CYAN}Use -d for interactive deletion or -b for bulk deletion${RESET}"
        fi
    fi
}

# Run main function
main "$@"
