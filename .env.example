# Confluent Cloud Tools - Environment Configuration Template
# Copy this file to .env and fill in your actual values
# Generated by confluent-env-export or manually configured

# Environment Information
export CC_ENV=env-12345
export CC_ENV_NAME=your-environment-name

# Kafka Cluster Configuration
export CC_KAFKA_CLUSTER=lkc-12345
export CC_KAFKA_BROKER=pkc-12345.us-east-2.aws.confluent.cloud:9092
export CONFLUENT_REGION=us-east-2
export CC_CLOUD=aws

# Kafka TableFlow Configuration (uses same region as Kafka cluster)
export CC_TF_API_KEY=""
export CC_TF_API_SECRET=""
export CC_TF_CATALOG_URL=""

# Kafka API Credentials
export CC_KC_API_KEY=your-kafka-api-key-here
export CC_KC_API_SECRET=your-kafka-api-secret-here

# Schema Registry Configuration
export CC_SR_ID=lsrc-12345
export CC_SR_HOST=psrc-12345.us-east-2.aws.confluent.cloud
export CC_SR_API_KEY=your-sr-api-key-here
export CC_SR_API_SECRET=your-sr-api-secret-here

# Cloud API Credentials (for management operations)
export CC_CLOUD_API_KEY=your-cloud-api-key-here
export CC_CLOUD_API_SECRET=your-cloud-api-secret-here

# Legacy format for backward compatibility
export CONFLUENT_ENVIRONMENT_ID=$CC_ENV
export CONFLUENT_CLUSTER_ID=$CC_KAFKA_CLUSTER
export CONFLUENT_BOOTSTRAP_SERVERS=$CC_KAFKA_BROKER
export CONFLUENT_REGION=$CC_REGION
export CONFLUENT_CLOUD=$CC_CLOUD
export CONFLUENT_CLOUD_API_KEY=$CC_KC_API_KEY
export CONFLUENT_CLOUD_API_SECRET=$CC_KC_API_SECRET
export CONFLUENT_SCHEMA_REGISTRY_URL=https://$CC_SR_HOST
export CONFLUENT_SCHEMA_REGISTRY_API_KEY=$CC_SR_API_KEY
export CONFLUENT_SCHEMA_REGISTRY_API_SECRET=$CC_SR_API_SECRET

# Optional: Custom Configuration Directory
# export CC_CONFIG_DIR=/path/to/custom/config/dir

# Optional: Default Output Format (json|yaml|table|csv)
# export CC_DEFAULT_OUTPUT_FORMAT=table

# Optional: Notification Settings
# export CC_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
# export CC_NOTIFICATION_EMAIL=admin@yourcompany.com
